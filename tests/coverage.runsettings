<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,lcov</Format>
          <Include>[FitLead.Api]*,[FitLead.Application]*,[FitLead.Infrastructure]*,[FitLead.Domain]*,[FitLead.Common]*</Include>
          <Exclude>[FitLead.IntegrationTests]*,[xunit.*]*,[*.Tests]*</Exclude>
          <ExcludeByFile>**/Migrations/*.cs,**/obj/**/*.cs,**/*.g.cs,**/*.g.i.cs</ExcludeByFile>
          <SingleHit>false</SingleHit>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
