{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "AllowedHosts": [
      "fitlead.space",
      "www.fitlead.space"
    ]
  },
  "ClientApp": {
    "BaseUrl": "http://localhost:3000"
  },
  "DemoSeed": {
    "Enabled": false
  },
  "SmokeSeed": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "FitLead.Api",
    "Audience": "FitLead.Client",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14
  },
  "MediaAssets": {
    "AllowedRegistrationProviders": [
      "Uploadcare"
    ]
  }
}
