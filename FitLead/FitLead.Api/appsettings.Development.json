{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DeletionTokens": {
    "LifetimeMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "ClientApp": {
    "BaseUrl": "http://localhost:3000"
  },
  "DemoSeed": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "FitLead.Api",
    "Audience": "FitLead.Client",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14
  },
  "MediaAssets": {
    "AllowedRegistrationProviders": [
      "Uploadcare",
      "LocalDev"
    ]
  }
}
